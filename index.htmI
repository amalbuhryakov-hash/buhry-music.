<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Buhrу Music</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #0b0b0f;
  color: white;
  min-height: 100vh;
}

header {
  padding: 30px 20px;
  text-align: center;
  background: #111118;
}

header h1 {
  font-size: 32px;
}

header p {
  color: #999;
  margin-top: 8px;
}

.search {
  padding: 20px;
}

.search input {
  width: 100%;
  padding: 15px;
  border-radius: 12px;
  border: 1px solid #333;
  background: #181820;
  color: white;
  font-size: 16px;
  outline: none;
}

.section {
  padding: 10px 20px 100px;
}

.section h2 {
  margin: 15px 0;
}

.song {
  display: flex;
  align-items: center;
  gap: 15px;
  background: #15151c;
  padding: 15px;
  margin-bottom: 10px;
  border-radius: 14px;
}

.cover {
  width: 55px;
  height: 55px;
  background: #292938;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25px;
}

.song-info {
  flex: 1;
}

.song-info h3 {
  font-size: 17px;
}

.song-info p {
  color: #888;
  margin-top: 5px;
  font-size: 13px;
}

.play {
  border: none;
  background: #ffffff;
  color: #000;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  font-size: 18px;
}

.player {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #181820;
  border-top: 1px solid #333;
  padding: 12px 20px;
  text-align: center;
}

.player-title {
  font-size: 14px;
  margin-bottom: 8px;
}

.controls button {
  border: none;
  background: transparent;
  color: white;
  font-size: 25px;
  margin: 0 15px;
}
</style>
</head>

<body>

<header>
  <h1>🎵 Buhrу Music</h1>
  <p>Твоя музыка — в одном месте</p>
</header>

<div class="search">
  <input
    type="text"
    id="search"
    placeholder="🔎 Найти песню..."
    oninput="searchSongs()"
  >
</div>

<div class="section">
  <h2>🎧 Музыка</h2>

  <div id="songs">

    <div class="song" data-name="Summer Dreams">
      <div class="cover">🎵</div>
      <div class="song-info">
        <h3>Summer Dreams</h3>
        <p>Open License Music</p>
      </div>
      <button class="play" onclick="playSong('Summer Dreams')">▶</button>
    </div>

    <div class="song" data-name="Night Drive">
      <div class="cover">🌙</div>
      <div class="song-info">
        <h3>Night Drive</h3>
        <p>Open License Music</p>
      </div>
      <button class="play" onclick="playSong('Night Drive')">▶</button>
    </div>

    <div class="song" data-name="Dreaming">
      <div class="cover">✨</div>
      <div class="song-info">
        <h3>Dreaming</h3>
        <p>Open License Music</p>
      </div>
      <button class="play" onclick="playSong('Dreaming')">▶</button>
    </div>

  </div>
</div>

<div class="player">
  <div class="player-title" id="playerTitle">
    Выбери песню
  </div>

  <div class="controls">
    <button onclick="previousSong()">⏮</button>
    <button onclick="togglePlay()">▶️</button>
    <button onclick="nextSong()">⏭</button>
  </div>
</div>

<script>
let currentSong = "";

function playSong(name) {
  currentSong = name;
  document.getElementById("playerTitle").textContent =
    "🎵 " + name;
}

function togglePlay() {
  if (currentSong) {
    alert("Сейчас: " + currentSong);
  } else {
    alert("Сначала выбери песню");
  }
}

function previousSong() {
  alert("Предыдущая песня");
}

function nextSong() {
  alert("Следующая песня");
}

function searchSongs() {
  const text =
    document.getElementById("search").value.toLowerCase();

  const songs =
    document.querySelectorAll(".song");

  songs.forEach(song => {
    const name =
      song.dataset.name.toLowerCase();

    if (name.includes(text)) {
      song.style.display = "flex";
    } else {
      song.style.display = "none";
    }
  });
}
</script>

</body>
</html>
