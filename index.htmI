<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Buhry Music</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #0b0b0f;
      color: white;
      min-height: 100vh;
    }

    header {
      padding: 30px 20px;
      text-align: center;
      background: #111118;
    }

    header h1 {
      font-size: 32px;
    }

    header p {
      color: #999;
      margin-top: 8px;
    }

    .search {
      margin: 20px;
    }

    .search input {
      width: 100%;
      padding: 15px;
      border-radius: 12px;
      border: none;
      background: #1b1b23;
      color: white;
      font-size: 16px;
      outline: none;
    }

    .music {
      padding: 0 20px 30px;
    }

    .song {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 15px;
      margin-bottom: 12px;
      background: #17171f;
      border-radius: 15px;
    }

    .cover {
      width: 55px;
      height: 55px;
      border-radius: 12px;
      background: linear-gradient(135deg, #6c5ce7, #00cec9);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
    }

    .song-info {
      flex: 1;
    }

    .song-info h3 {
      font-size: 17px;
    }

    .song-info p {
      color: #888;
      margin-top: 5px;
      font-size: 14px;
    }

    .play {
      width: 45px;
      height: 45px;
      border: none;
      border-radius: 50%;
      background: #6c5ce7;
      color: white;
      font-size: 18px;
    }

    footer {
      text-align: center;
      padding: 25px;
      color: #666;
    }
  </style>
</head>

<body>

  <header>
    <h1>🎵 Buhry Music</h1>
    <p>Твоя музыка — в одном месте</p>
  </header>

  <div class="search">
    <input type="text" placeholder="🔎 Поиск музыки...">
  </div>

  <main class="music">

    <div class="song">
      <div class="cover">🎵</div>

      <div class="song-info">
        <h3>Моя первая песня</h3>
        <p>Buhry Music</p>
      </div>

      <button class="play">▶</button>
    </div>

    <div class="song">
      <div class="cover">🎧</div>

      <div class="song-info">
        <h3>Новая музыка</h3>
        <p>Open Music</p>
      </div>

      <button class="play">▶</button>
    </div>

    <div class="song">
      <div class="cover">🎶</div>

      <div class="song-info">
        <h3>Мой плейлист</h3>
        <p>Buhry Music</p>
      </div>

      <button class="play">▶</button>
    </div>

  </main>

  <footer>
    © 2026 Buhry Music
  </footer>

</body>
</html>
