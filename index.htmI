<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BuHry Music</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #08090d;
  color: white;
  min-height: 100vh;
}

header {
  text-align: center;
  padding: 35px 20px;
  background: #11131a;
  border-bottom: 1px solid #292c38;
}

.logo {
  font-size: 38px;
  font-weight: bold;
}

.logo span {
  color: #7c5cff;
}

.subtitle {
  margin-top: 10px;
  color: #8d93a1;
  font-size: 17px;
}

.container {
  max-width: 700px;
  margin: auto;
  padding: 25px 18px 120px;
}

.search {
  width: 100%;
  padding: 17px;
  border-radius: 16px;
  border: 1px solid #30333d;
  background: #171923;
  color: white;
  font-size: 17px;
  outline: none;
}

.add {
  margin-top: 14px;
  width: 100%;
  padding: 17px;
  border: none;
  border-radius: 16px;
  background: #7c5cff;
  color: white;
  font-size: 18px;
  font-weight: bold;
  cursor: pointer;
}

.add:active {
  transform: scale(.98);
}

input[type="file"] {
  display: none;
}

.playlist {
  margin-top: 25px;
}

.song {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 15px;
  margin-bottom: 10px;
  background: #151720;
  border: 1px solid #292c38;
  border-radius: 15px;
  cursor: pointer;
}

.song:hover {
  background: #1b1e29;
}

.song-icon {
  font-size: 28px;
}

.song-info {
  flex: 1;
  overflow: hidden;
}

.song-name {
  font-size: 16px;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.song-status {
  color: #8d93a1;
  font-size: 13px;
  margin-top: 4px;
}

.empty {
  text-align: center;
  color: #8d93a1;
  padding: 35px 10px;
}

.player {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #11131a;
  border-top: 1px solid #292c38;
  padding: 15px 18px 20px;
  backdrop-filter: blur(10px);
}

.now-playing {
  text-align: center;
  margin-bottom: 10px;
  color: #dfe1e8;
  font-weight: bold;
}

audio {
  width: 100%;
}
</style>
</head>

<body>

<header>
  <div class="logo">🎧 <span>BuHry</span> Music</div>
  <div class="subtitle">Твоя музыка. В одном месте.</div>
</header>

<div class="container">

  <input
    class="search"
    id="search"
    type="text"
    placeholder="🔎 Найти песню..."
  >

  <label class="add">
    ＋ Добавить музыку
    <input id="fileInput" type="file" accept="audio/*" multiple>
  </label>

  <div class="playlist" id="playlist">
    <div class="empty">
      Пока ничего не добавлено.<br>
      Выбери музыку на устройстве 🎵
    </div>
  </div>

</div>

<div class="player">
  <div class="now-playing" id="nowPlaying">
    Ничего не играет
  </div>

  <audio id="audio" controls></audio>
</div>

<script>
const fileInput = document.getElementById("fileInput");
const playlist = document.getElementById("playlist");
const audio = document.getElementById("audio");
const nowPlaying = document.getElementById("nowPlaying");
const search = document.getElementById("search");

let songs = [];

fileInput.addEventListener("change", function() {
  const files = Array.from(this.files);

  files.forEach(file => {
    songs.push({
      name: file.name,
      url: URL.createObjectURL(file)
    });
  });

  renderSongs();
});

function renderSongs(filter = "") {
  playlist.innerHTML = "";

  const filtered = songs.filter(song =>
    song.name.toLowerCase().includes(filter.toLowerCase())
  );

  if (filtered.length === 0) {
    playlist.innerHTML = `
      <div class="empty">
        Ничего не найдено 🎵
      </div>
    `;
    return;
  }

  filtered.forEach((song, index) => {
    const item = document.createElement("div");
    item.className = "song";

    item.innerHTML = `
      <div class="song-icon">🎵</div>
      <div class="song-info">
        <div class="song-name">${escapeHtml(song.name)}</div>
        <div class="song-status">Нажми, чтобы воспроизвести</div>
      </div>
      <div>▶️</div>
    `;

    item.addEventListener("click", () => {
      playSong(song);
    });

    playlist.appendChild(item);
  });
}

function playSong(song) {
  audio.src = song.url;
  audio.play();
  nowPlaying.textContent = "🎧 " + song.name;
}

search.addEventListener("input", function() {
  renderSongs(this.value);
});

function escapeHtml(text) {
  const div = document.createElement("div");
  div.textContent = text;
  return div.innerHTML;
}
</script>

</body>
</html>
